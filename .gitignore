dataset/phase_runs/v1/vggt_resolution_280_v1/*/*_cross_view_supported.ply
dataset/phase_runs/v1/vggt_resolution_336_v1/*/vggt_dense_evidence.npz
dataset/phase_runs/v1/vggt_resolution_336_v1/*/*_cross_view_supported.ply
