# Cadrille runtime layered on the already-installed PyTorch image.
# This avoids rebuilding PyTorch and keeps the host Python environment clean.
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

WORKDIR /workspace

RUN pip install --no-cache-dir \
    accelerate==0.34.2 \
    cadquery-ocp==7.7.2 \
    imageio==2.36.1 \
    numpy==2.2.0 \
    open3d \
    pillow \
    qwen-vl-utils==0.0.10 \
    scikit-image==0.25.0 \
    transformers==4.50.3 \
    trimesh==4.5.3 \
    tqdm

COPY . /workspace

CMD ["python", "-c", "import torch; print('Cadrille environment ready:', torch.__version__)"]
