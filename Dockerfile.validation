FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime@sha256:c8268a92a69bd500f8be0e665b2630ee006dadaf7bfbc24249141b15ff622755

LABEL org.opencontainers.image.title="Lalitha Phase 0 validation environment" \
      org.opencontainers.image.description="Pinned software-regression environment for Image2CAD" \
      org.opencontainers.image.source="https://github.com/TarunSamala/Image2CAD"

WORKDIR /workspace

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libgl1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-validation.txt /tmp/requirements-validation.txt
COPY constraints-validation.txt /tmp/constraints-validation.txt
RUN python -m pip install --no-cache-dir --no-build-isolation \
        -c /tmp/constraints-validation.txt -r /tmp/requirements-validation.txt \
    && python -c "import cadquery, cv2, flask, numpy, skimage, torch, torchvision, trimesh; assert torch.__version__.startswith('2.5.1'); assert torchvision.__version__.startswith('0.20.1'); print('validation environment ready')"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/workspace/pipeline

CMD ["python", "-m", "unittest", "discover", "-s", "tests", "-v"]
