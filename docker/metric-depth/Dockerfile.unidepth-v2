FROM image2cad-validation:phase0

ARG UNIDEPTH_COMMIT=8d8cfe4c7ee15297099983607febf0d4f32eb3d6

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && git clone https://github.com/lpiccinelli-eth/UniDepth.git /opt/unidepth \
    && git -C /opt/unidepth checkout "${UNIDEPTH_COMMIT}" \
    && python -m pip install --no-cache-dir --no-deps -e /opt/unidepth \
    && python -m pip install --no-cache-dir \
       "einops==0.8.1" "huggingface-hub==0.29.3" "timm==1.0.15" \
       "termcolor==2.5.0" "triton==3.1.0" "wandb==0.19.8" \
    && python -c "from unidepth.models import UniDepthV2; print('UniDepthV2 import OK')"

ENV PYTHONPATH=/opt/unidepth:/workspace
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace

LABEL org.opencontainers.image.title="Image2CAD UniDepth V2 benchmark"
LABEL org.opencontainers.image.description="Pinned ViT-S research-only metric-depth backend"
