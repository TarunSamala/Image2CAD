FROM image2cad-geometry-vggt:a288dd0

ARG METRIC3D_COMMIT=eb5b6fac0dc155e4e52f576e304fbf11655ff339

RUN git clone https://github.com/YvanYin/Metric3D.git /opt/metric3d \
    && git -C /opt/metric3d checkout "${METRIC3D_COMMIT}" \
    && python -m pip install --no-cache-dir \
       "numpy==1.26.4" "opencv-python-headless==4.10.0.84" \
       "mmengine==0.10.7" "timm==1.0.15" "plyfile==1.1" \
       "tensorboardX==2.6.4" "imgaug==0.4.0" "iopath==0.1.10"

RUN python -m pip uninstall -y opencv-python \
    && python -m pip install --no-cache-dir --force-reinstall --no-deps \
       "opencv-python-headless==4.10.0.84"

RUN python -m pip install --no-cache-dir --no-deps "mmcv-lite==2.2.0"

ENV PYTHONPATH=/opt/metric3d:/workspace
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace

LABEL org.opencontainers.image.title="Image2CAD Metric3D V2 benchmark"
LABEL org.opencontainers.image.description="Pinned ViT-S metric-depth and normal research backend"
